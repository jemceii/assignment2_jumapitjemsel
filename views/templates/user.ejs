<div
  id="userSection"
  style="
    display: grid;
    grid-template-columns: 1fr auto auto;
    align-items: center;
    gap: 10px;
    padding-top: 1vh;
    padding-bottom: 1vh;
    padding-left: 5vw;
    padding-right: 5vw;
    background-color: aliceblue;
    border-radius: 15px;
    margin-bottom: 1vh;
  "
>
  <p><%= user %> (<%= user_type %>)</p>
  <a
    href="/promoteUser?email=<%= userEmail %>"
    class="btn btn-danger rounded-pill px-3"
    type="button"
    >Promote to Admin</a
  >

  <a
    href="/demoteUser?email=<%= userEmail %>"
    class="btn btn-success rounded-pill px-3"
    type="button"
    >Demote to User</a
  >
</div>
